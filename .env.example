# Private server settings. Copy this file to .env and never publish .env.
OPENAI_API_KEY=replace_with_your_private_api_key
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
NODE_ENV=development
# Generate a long random value for SESSION_SECRET (at least 32 random characters).
SESSION_SECRET=replace_with_a_long_random_secret_value
# Configure these in the private .env file. Do not put real passwords in website HTML.
OWNER_CEO_ID=84694
OWNER_CEO_PASSWORD=replace_with_your_CEO_password
OWNER_CEO_NAME=Tiwari Amit
OWNER_SECOND_ID=Palak Jaa
OWNER_SECOND_PASSWORD=replace_with_your_owner_password
OWNER_SECOND_NAME=Palak Jaa
# Optional comma-separated exact origins for production, e.g. https://www.example.com,https://example.com
ALLOWED_ORIGINS=
